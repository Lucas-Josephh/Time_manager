{
  "name": "time-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24.9.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive --filter frontend --filter backend run dev",
    "dev:database": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --wait database",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "start": "docker compose up --build -d --wait",
    "stop": "docker compose down",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:studio": "pnpm --filter backend prisma:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:cov": "turbo run test:cov"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "prettier": "3.9.9"
  }
}
